# General to ignore
bin/
tmp/
build/
install/
log/
__pycache__/
*generatedFiles/
*generatedTorchLib/
# History files
/.devcontainer/.bash_history
/.devcontainer/commandhistory/.bash_history

# Thunder Control
/src/thunder_control/robots/*
/src/thunder_control/include/*
/src/thunder_control/src/*
!/src/thunder_control/robots/.gitkeep
!/src/thunder_control/include/.gitkeep
!/src/thunder_control/src/.gitkeep

# Thunder Robot Test
/src/thunder_robot_test/robots/*
/src/thunder_robot_test/include/*
/src/thunder_robot_test/src/*
!/src/thunder_robot_test/robots/.gitkeep
!/src/thunder_robot_test/include/.gitkeep
!/src/thunder_robot_test/src/.gitkeep

# Thunder ROS Test
/src/thunder_ros_test/src/*
!/src/thunder_ros_test/src/rrr_server_test/
