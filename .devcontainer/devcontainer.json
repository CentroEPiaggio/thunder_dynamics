// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/cpp
{
	// thunder_dev era pydev
	"name": "thunder-C++",
	"build": {
		"context": "..",
		"dockerfile": "Dockerfile",
		"args": {
			"USERNAME": "thunder_dev",
			"UBUNTUVERSION": "22.04"
		}
	},
	// Features to add to the dev container. More info: https://containers.dev/features.
	"features": {
		"ghcr.io/balazs23/devcontainers-features/bazel:1": {},
	},
	// "initializeCommand": "mkdir -p ${localEnv:HOME}/.cache && chmod 777 ${localEnv:HOME}/.cache",
	"workspaceMount": "source=${localWorkspaceFolder},target=/home/thunder_dev/${localWorkspaceFolderBasename},type=bind,consistency=cached",
	"workspaceFolder": "/home/thunder_dev/${localWorkspaceFolderBasename}",
	"mounts": [
		{
			"source": "${localWorkspaceFolder}/.devcontainer",
			"target": "/commandhistory",
			"type": "bind"
		}
	],
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],
	// Use 'postCreateCommand' to run commands after the container is created.
	"postCreateCommand": "/home/thunder_dev/scripts/bootstrap.sh ${containerWorkspaceFolder}",
	"updateContentCommand": "/home/thunder_dev/scripts/bootstrap.sh ${containerWorkspaceFolder}",
	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.cpptools",
				"ms-vscode.cpptools-extension-pack",
				"eamodio.gitlens",
				"vscode-icons-team.vscode-icons",
				"sandy081.todotasks",
				"BazelBuild.vscode-bazel",
				"twxs.cmake"
			]
		}
	},
	"remoteUser": "thunder_dev",
	"containerUser": "thunder_dev",
	"updateRemoteUserUID": true,
	"containerEnv": {
		"SHELL": "/bin/bash"
	},
	"runArgs": [
		"--name",
		"thunder_ws",
		"--user=thunder_dev",
		"--network=host"
	]
}