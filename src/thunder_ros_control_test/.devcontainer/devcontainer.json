{
  "name": "Thunder ros2_control test workspace (Jazzy)",
  "build": { "dockerfile": "Dockerfile" },
  "workspaceFolder": "/workspaces/thunder_ros_control_test",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/thunder_ros_control_test,type=bind",
  "remoteUser": "ros",
  "runArgs": ["--name", "thunder_ros_control_test", "--network=host"],
  "customizations": {
    "vscode": {
      "extensions": ["ms-iot.vscode-ros", "ms-vscode.cpptools", "ms-vscode.cmake-tools"]
    }
  }
}
