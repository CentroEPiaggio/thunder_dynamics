<?xml version="1.0"?>
<!-- Floating-base test fixture: TRON1-like tree, base + two legs (abad x, hip y, knee -y, wheel y).
     Every link has a CoM offset and a principal inertia rotated by its inertial frame. Generated by make_biped_tree.py. -->
<robot name="biped_tree">
  <link name="base_link">
    <inertial>
      <origin xyz="0.046 0.001 -0.164" rpy="0.1 -0.2 0.05"/>
      <mass value="9.6"/>
      <inertia ixx="0.14" ixy="0" ixz="0" iyy="0.11" iyz="0" izz="0.09"/>
    </inertial>
  </link>
  <link name="abad_L">
    <inertial>
      <origin xyz="-0.07 0.045 0.001" rpy="0.3 0.1 -0.2"/>
      <mass value="1.47"/>
      <inertia ixx="0.0025" ixy="0" ixz="0" iyy="0.0021" iyz="0" izz="0.0014"/>
    </inertial>
  </link>
  <link name="hip_L">
    <inertial>
      <origin xyz="-0.029 -0.048 -0.04" rpy="-0.2 0.4 0.1"/>
      <mass value="2.3"/>
      <inertia ixx="0.023" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.004"/>
    </inertial>
  </link>
  <link name="knee_L">
    <inertial>
      <origin xyz="0.119 0.011 -0.204" rpy="0.15 -0.3 0.25"/>
      <mass value="1.49"/>
      <inertia ixx="0.018" ixy="0" ixz="0" iyy="0.016" iyz="0" izz="0.003"/>
    </inertial>
  </link>
  <link name="wheel_L">
    <inertial>
      <origin xyz="0 0.008 0" rpy="0.05 0 0.3"/>
      <mass value="1.08"/>
      <inertia ixx="0.0052" ixy="0" ixz="0" iyy="0.0097" iyz="0" izz="0.0052"/>
    </inertial>
  </link>
  <link name="abad_R">
    <inertial>
      <origin xyz="-0.07 -0.045 0.001" rpy="0.3 -0.1 -0.2"/>
      <mass value="1.47"/>
      <inertia ixx="0.0025" ixy="0" ixz="0" iyy="0.0021" iyz="0" izz="0.0014"/>
    </inertial>
  </link>
  <link name="hip_R">
    <inertial>
      <origin xyz="-0.029 0.048 -0.04" rpy="-0.2 0.4 -0.1"/>
      <mass value="2.3"/>
      <inertia ixx="0.023" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.004"/>
    </inertial>
  </link>
  <link name="knee_R">
    <inertial>
      <origin xyz="0.119 -0.011 -0.204" rpy="0.15 -0.3 0.25"/>
      <mass value="1.49"/>
      <inertia ixx="0.018" ixy="0" ixz="0" iyy="0.016" iyz="0" izz="0.003"/>
    </inertial>
  </link>
  <link name="wheel_R">
    <inertial>
      <origin xyz="0 -0.008 0" rpy="0.05 0 0.3"/>
      <mass value="1.08"/>
      <inertia ixx="0.0052" ixy="0" ixz="0" iyy="0.0097" iyz="0" izz="0.0052"/>
    </inertial>
  </link>
  <joint name="abad_L_joint" type="revolute">
    <origin xyz="0.056 0.105 -0.26" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="abad_L"/>
    <axis xyz="1 0 0"/>
    <limit lower="-2" upper="2" effort="80" velocity="15"/>
  </joint>
  <joint name="hip_L_joint" type="revolute">
    <origin xyz="-0.077 0.0205 0" rpy="0 0.05 0"/>
    <parent link="abad_L"/>
    <child link="hip_L"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2" upper="2" effort="80" velocity="15"/>
  </joint>
  <joint name="knee_L_joint" type="revolute">
    <origin xyz="-0.15 -0.0205 -0.26" rpy="0 0 0.1"/>
    <parent link="hip_L"/>
    <child link="knee_L"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-2" upper="2" effort="80" velocity="15"/>
  </joint>
  <joint name="wheel_L_joint" type="continuous">
    <origin xyz="0.15 0.0435 -0.26" rpy="0 0 0"/>
    <parent link="knee_L"/>
    <child link="wheel_L"/>
    <axis xyz="0 1 0"/>
  </joint>
  <joint name="abad_R_joint" type="revolute">
    <origin xyz="0.056 -0.105 -0.26" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="abad_R"/>
    <axis xyz="1 0 0"/>
    <limit lower="-2" upper="2" effort="80" velocity="15"/>
  </joint>
  <joint name="hip_R_joint" type="revolute">
    <origin xyz="-0.077 -0.0205 0" rpy="0 0.05 0"/>
    <parent link="abad_R"/>
    <child link="hip_R"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2" upper="2" effort="80" velocity="15"/>
  </joint>
  <joint name="knee_R_joint" type="revolute">
    <origin xyz="-0.15 0.0205 -0.26" rpy="0 0 -0.1"/>
    <parent link="hip_R"/>
    <child link="knee_R"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-2" upper="2" effort="80" velocity="15"/>
  </joint>
  <joint name="wheel_R_joint" type="continuous">
    <origin xyz="0.15 -0.0435 -0.26" rpy="0 0 0"/>
    <parent link="knee_R"/>
    <child link="wheel_R"/>
    <axis xyz="0 1 0"/>
  </joint>
</robot>
